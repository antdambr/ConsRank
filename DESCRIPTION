Package: ConsRank
Type: Package
Title: Compute the Median Ranking(s) According to the Kemeny's Axiomatic
    Approach
Version: 3.1.2
Date: 2026-11-18
Authors@R: c(person("Antonio", "D'Ambrosio", role = c("aut", "cre"), email = "antdambr@unina.it"), person("Sonia", "Amodio", role = "ctb"), person("Giulio", "Mazzeo", role = "ctb"), person("Alessandro", "Albano", role = "ctb"), person("Antonella", "Plaia", role = "ctb"), person("Maurizio", "Romano", role = "ctb"))
